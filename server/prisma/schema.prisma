generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MANAGER
}

enum TokenStatus {
  WAITING
  SERVING
  SERVED
  CANCELLED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(MANAGER)

  queues    Queue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Queue {
  id          String   @id @default(cuid())
  name        String
  description String?

  managerId   String
  manager     User @relation(fields: [managerId], references: [id])

  tokens      Token[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Token {
  id           String      @id @default(cuid())

  personName   String

  position     Int

  status       TokenStatus @default(WAITING)

  queueId       String
  queue         Queue @relation(fields: [queueId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())

  servedAt      DateTime?

  cancelledAt   DateTime?

  @@unique([queueId, position])
  @@index([queueId])
  @@index([status])
}